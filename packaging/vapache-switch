#!/bin/sh
set -eu

assume_yes=false
case "${1:-}" in
    -y|--yes)
        assume_yes=true
        shift
        ;;
    "") ;;
    *)
        echo "Usage: vapache-switch [--yes]" >&2
        exit 2
        ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "vapache-switch: run this command as root" >&2
    exit 1
fi
if ! command -v systemctl >/dev/null 2>&1; then
    echo "vapache-switch: systemd is required" >&2
    exit 1
fi

apache_service=
for candidate in apache2.service httpd.service; do
    if systemctl is-active --quiet "$candidate" 2>/dev/null; then
        apache_service=$candidate
        break
    fi
done
for candidate in apache2.service httpd.service; do
    [ -z "$apache_service" ] || break
    if systemctl list-unit-files "$candidate" --no-legend 2>/dev/null \
        | grep -q "^$candidate"; then
        apache_service=$candidate
        break
    fi
done

echo "Checking the existing Apache configuration with vapache..."
/usr/sbin/vapachectl configtest

apache_active=false
apache_enabled=false
if [ -n "$apache_service" ]; then
    systemctl is-active --quiet "$apache_service" && apache_active=true
    systemctl is-enabled --quiet "$apache_service" && apache_enabled=true
    echo "Detected $apache_service (active=$apache_active, enabled=$apache_enabled)."
    echo "Its configuration files will not be modified."
    echo "The switch will disable and stop $apache_service, then enable and start vapache.service."
else
    echo "No apache2.service or httpd.service unit is installed."
    echo "The switch will enable and start vapache.service using the detected Apache configuration."
fi

if [ "$assume_yes" != true ]; then
    if [ ! -r /dev/tty ]; then
        echo "vapache-switch: no terminal available; pass --yes for an unattended switch" >&2
        exit 1
    fi
    printf "Continue? [y/N] " >/dev/tty
    IFS= read -r answer </dev/tty || answer=
    case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *)
            echo "No changes made."
            exit 0
            ;;
    esac
fi

systemctl daemon-reload
if [ -n "$apache_service" ]; then
    if ! systemctl disable --now "$apache_service"; then
        echo "vapache-switch: could not disable $apache_service; restoring its previous state" >&2
        if [ "$apache_enabled" = true ]; then
            systemctl enable "$apache_service" >/dev/null 2>&1 || true
        fi
        if [ "$apache_active" = true ]; then
            systemctl start "$apache_service" >/dev/null 2>&1 || true
        fi
        exit 1
    fi
fi

if systemctl enable --now vapache.service; then
    echo "vapache.service is enabled and running; the Apache configuration was left unchanged."
    exit 0
fi

echo "vapache-switch: vapache failed to start; restoring the previous Apache service state" >&2
systemctl disable --now vapache.service >/dev/null 2>&1 || true
if [ -n "$apache_service" ]; then
    if [ "$apache_enabled" = true ]; then
        systemctl enable "$apache_service" >/dev/null 2>&1 || true
    fi
    if [ "$apache_active" = true ]; then
        systemctl start "$apache_service" >/dev/null 2>&1 || true
    fi
fi
exit 1
